<UserControl x:Class="ChatLan.Controls.StickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ChatLan.Controls"
             Focusable="False" IsHitTestVisible="False" SnapsToDevicePixels="True">
    <Grid x:Name="Host" Background="Transparent">
        <Grid x:Name="Anim" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="Scale" />
                    <RotateTransform x:Name="Rotate" />
                    <TranslateTransform x:Name="Slide" />
                </TransformGroup>
            </Grid.RenderTransform>
            <c:EmojiIcon x:Name="Glyph" Emoji="😀" Size="62" />
        </Grid>
    </Grid>
</UserControl>
