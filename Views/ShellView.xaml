<UserControl x:Class="ChatLan.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ChatLan.Controls"
             xmlns:vm="clr-namespace:ChatLan.ViewModels"
             xmlns:views="clr-namespace:ChatLan.Views">
    <UserControl.Resources>

        <!-- Coches : envoyé / reçu / lu -->
        <Style x:Key="TickPath" TargetType="Path" BasedOn="{StaticResource Icon16}">
            <Setter Property="Fill" Value="{DynamicResource TickNormal}" />
            <Setter Property="Data" Value="{StaticResource IconCheck}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="1">
                    <Setter Property="Data" Value="{StaticResource IconCheckDouble}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="2">
                    <Setter Property="Data" Value="{StaticResource IconCheckDouble}" />
                    <Setter Property="Fill" Value="{DynamicResource TickRead}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BubbleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="14.5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMine}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource BubbleOutText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Deleted}" Value="True">
                    <Setter Property="FontStyle" Value="Italic" />
                    <Setter Property="Opacity" Value="0.75" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BubbleMeta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BubbleMetaIn}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMine}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource BubbleMetaOut}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ===================== Ligne de contact / discussion ===================== -->
        <DataTemplate DataType="{x:Type vm:ConversationItem}">
            <Button Style="{StaticResource ListRowButton}" Command="{Binding OpenCommand}" Height="78">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Supprimer la discussion" Foreground="{DynamicResource Danger}"
                                  Command="{Binding DeleteChatCommand}" />
                    </ContextMenu>
                </Button.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                    </Grid.ColumnDefinitions>
                    <c:AvatarControl Grid.Column="1" Size="54" Label="{Binding Name}" Photo="{Binding Photo}"
                                     ShowOnline="{Binding ShowOnlineDot}" VerticalAlignment="Center" />
                    <Grid Grid.Column="3" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCommunities}" Width="15" Height="15" Stretch="Uniform"
                                  Fill="{DynamicResource AccentText}" VerticalAlignment="Center" Margin="0,0,6,0"
                                  Visibility="{Binding IsGroup, Converter={StaticResource BoolVis}}" />
                            <TextBlock Text="{Binding Name}" FontSize="16" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Medium" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasUnread}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Time}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUnread}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <DockPanel Grid.Row="1" Margin="0,3,0,0">
                            <Path DockPanel.Dock="Left" Style="{StaticResource TickPath}" Width="15" Height="15" Margin="0,0,4,0"
                                  VerticalAlignment="Center" Visibility="{Binding ShowTick, Converter={StaticResource BoolVis}}" />
                            <TextBlock Text="{Binding PreviewText}" FontSize="13.5" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Typing}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>
                        <Border Grid.Row="1" Grid.Column="1" MinWidth="22" Height="22" CornerRadius="11" Padding="7,0" Margin="10,3,0,0"
                                Background="{DynamicResource AccentGradient}"
                                Visibility="{Binding HasUnread, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding Unread}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- ============================ Message ============================ -->
        <DataTemplate DataType="{x:Type vm:MessageItem}">
            <StackPanel>
                <Border Visibility="{Binding HasHeader, Converter={StaticResource BoolVis}}" HorizontalAlignment="Center"
                        Background="{DynamicResource PillBg}" BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1"
                        CornerRadius="12" Padding="14,5" Margin="0,14,0,10">
                    <TextBlock Text="{Binding DateHeader}" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" />
                </Border>

                <Grid x:Name="Root" HorizontalAlignment="{Binding Align}" Margin="{Binding Spacing}" Opacity="1">
                    <Grid.RenderTransform><TranslateTransform Y="10" /></Grid.RenderTransform>

                    <StackPanel MaxWidth="520">
                        <!-- nom de l'expéditeur (groupe) -->
                        <TextBlock Text="{Binding SenderName}" FontSize="12" FontWeight="SemiBold" Margin="10,0,0,3"
                                   Foreground="{DynamicResource AccentText}"
                                   Visibility="{Binding ShowSender, Converter={StaticResource BoolVis}}" />

                        <Border x:Name="Bubble" MaxWidth="520" Padding="14,9" CornerRadius="{Binding Radius}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource BubbleIn}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource BubbleInBorder}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMine}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BubbleOut}" />
                                            <Setter Property="BorderThickness" Value="0" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSticker}" Value="True">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Padding" Value="0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Répondre" Command="{Binding ReplyCommand}" />
                                    <MenuItem Header="Réagir 👍" Command="{Binding ReactCommand}" CommandParameter="👍" />
                                    <MenuItem Header="Transférer…" Command="{Binding ForwardCommand}" />
                                    <MenuItem Header="Modifier" Command="{Binding EditCommand}" />
                                    <MenuItem Header="Copier" Command="{Binding CopyCommand}" />
                                    <MenuItem Header="Ouvrir la pièce jointe" Command="{Binding OpenMediaCommand}" />
                                    <MenuItem Header="Télécharger à nouveau" Command="{Binding RetryCommand}" />
                                    <MenuItem Header="Supprimer pour moi" Command="{Binding DeleteForMeCommand}" />
                                    <MenuItem Header="Supprimer pour tous" Foreground="{DynamicResource Danger}"
                                              Command="{Binding DeleteForAllCommand}"
                                              Visibility="{Binding IsMine, Converter={StaticResource BoolVis}}" />
                                </ContextMenu>
                            </Border.ContextMenu>

                            <StackPanel>
                                <!-- transféré -->
                                <TextBlock Text="{Binding ForwardedText}" FontSize="11.5" FontStyle="Italic" Margin="0,0,0,5"
                                           Foreground="{DynamicResource BubbleMetaIn}"
                                           Visibility="{Binding Forwarded, Converter={StaticResource BoolVis}}" />

                                <!-- citation de la réponse -->
                                <Border Background="{DynamicResource QuoteBg}" CornerRadius="10" Padding="0,6,9,6" Margin="0,0,0,6"
                                        Visibility="{Binding HasReply, Converter={StaticResource BoolVis}}">
                                    <Grid>
                                        <Border Width="3" CornerRadius="2" Background="{DynamicResource Accent}"
                                                HorizontalAlignment="Left" Margin="0,0,0,0" />
                                        <StackPanel Margin="10,0,0,0">
                                            <TextBlock Text="{Binding ReplyAuthor}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentText}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ReplyPreview}" FontSize="12.5" MaxHeight="38" MaxWidth="340"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextSecondary}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- image fixe -->
                                <Border CornerRadius="12" ClipToBounds="True" MaxWidth="360" Margin="0,0,0,4"
                                        Visibility="{Binding IsStaticImage, Converter={StaticResource BoolVis}}">
                                    <Image Source="{Binding MediaSource}" Stretch="Uniform" MaxHeight="360" />
                                </Border>

                                <!-- GIF animé -->
                                <Border CornerRadius="12" ClipToBounds="True" MaxWidth="330" Margin="0,0,0,4"
                                        Visibility="{Binding IsGifImage, Converter={StaticResource BoolVis}}">
                                    <c:AnimatedGif Path="{Binding MediaPath}" MaxWidth="330" MaxHeight="330" />
                                </Border>

                                <!-- pièce jointe pas encore téléchargée -->
                                <Border Background="{DynamicResource MediaBg}" CornerRadius="12" Padding="12,10" Margin="0,0,0,4"
                                        Visibility="{Binding MediaMissing, Converter={StaticResource BoolVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconDownload}" Style="{StaticResource Icon18}"
                                              Fill="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                        <TextBlock Text="Pièce jointe non téléchargée" Margin="10,0,12,0" VerticalAlignment="Center"
                                                   FontSize="13" Foreground="{DynamicResource TextSecondary}" />
                                        <Button Style="{StaticResource TextButton}" Content="Télécharger" Padding="8,4"
                                                Command="{Binding RetryCommand}" />
                                    </StackPanel>
                                </Border>

                                <!-- vidéo -->
                                <Border Background="{DynamicResource MediaBg}" CornerRadius="12" Padding="10" Margin="0,0,0,4"
                                        Visibility="{Binding IsVideo, Converter={StaticResource BoolVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="46" Height="46" CornerRadius="23" Background="{DynamicResource AccentGradient}">
                                            <Path Data="{StaticResource IconPlay}" Fill="#FFFFFF" Width="20" Height="20"
                                                  Stretch="Uniform" Margin="3,0,0,0" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="Vidéo" FontWeight="SemiBold" FontSize="13.5" />
                                            <TextBlock Text="{Binding DurationText}" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondary}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource TextButton}" Content="Ouvrir"
                                                Command="{Binding OpenMediaCommand}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- message vocal / audio -->
                                <Border Background="{DynamicResource MediaBg}" CornerRadius="12" Padding="8,6" Margin="0,0,0,4"
                                        Visibility="{Binding IsVoice, Converter={StaticResource BoolVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource IconButton}" Width="36" Height="36"
                                                Command="{Binding PlayVoiceCommand}" ToolTip="Écouter">
                                            <Path Data="{StaticResource IconPlay}" Style="{StaticResource Icon18}"
                                                  Fill="{DynamicResource AccentText}" />
                                        </Button>
                                        <ProgressBar Style="{StaticResource ThinProgress}" Width="140" Margin="8,0"
                                                     Value="{Binding PlayProgress, Mode=OneWay}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DurationText}" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondary}" Margin="2,0,4,0" />
                                    </StackPanel>
                                </Border>

                                <!-- document -->
                                <Border Background="{DynamicResource MediaBg}" CornerRadius="12" Padding="10" Margin="0,0,0,4"
                                        Visibility="{Binding IsFile, Converter={StaticResource BoolVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource AccentSoft}">
                                            <Path Data="{StaticResource IconDoc}" Width="20" Height="20" Stretch="Uniform"
                                                  Fill="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MediaName}" FontSize="13.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="240" />
                                            <TextBlock Text="{Binding FileSubtitle}" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondary}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="34" Height="34"
                                                Command="{Binding OpenMediaCommand}" ToolTip="Ouvrir">
                                            <Path Data="{StaticResource IconDownload}" Style="{StaticResource Icon16}"
                                                  Fill="{DynamicResource AccentText}" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- sticker / GIF animé -->
                                <c:StickerControl Emoji="{Binding Text}" EmojiSize="66" HorizontalAlignment="Center"
                                                  Visibility="{Binding IsSticker, Converter={StaticResource BoolVis}}" />

                                <!-- texte (ou légende), emojis en couleur -->
                                <c:EmojiTextBlock EmojiText="{Binding Display}" Style="{StaticResource BubbleText}"
                                                  Visibility="{Binding IsSticker, Converter={StaticResource InvVis}}" />

                                <!-- heure + modifié + coches -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,0,-2">
                                    <TextBlock Text="{Binding EditedText}" FontSize="10.5" Margin="0,0,6,0"
                                               Foreground="{DynamicResource BubbleMetaIn}"
                                               Visibility="{Binding IsEdited, Converter={StaticResource BoolVis}}" />
                                    <TextBlock Text="{Binding Time}" Style="{StaticResource BubbleMeta}" />
                                    <Path Style="{StaticResource TickPath}" Margin="3,0,0,0" Width="16" Height="16"
                                          Visibility="{Binding IsMine, Converter={StaticResource BoolVis}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- réactions reçues -->
                        <ItemsControl ItemsSource="{Binding Reactions}" HorizontalAlignment="{Binding Align}" Margin="4,3,4,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ReactionPill}" Margin="0,0,4,2"
                                            Command="{Binding DataContext.ReactCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Emoji}"
                                            ToolTip="{Binding Emoji}">
                                        <StackPanel Orientation="Horizontal">
                                            <c:EmojiIcon Emoji="{Binding Emoji}" Size="14" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding CountText}" FontSize="11.5" Margin="4,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondary}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- réactions rapides au survol : superposées à la bulle, elles ne décalent plus le message -->
                    <Border x:Name="ReactBar" Visibility="Collapsed" Panel.ZIndex="8"
                            HorizontalAlignment="{Binding Align}" VerticalAlignment="Top" Margin="0,-40,0,0"
                            Background="{DynamicResource BgElevated}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="14" Padding="3">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" />
                        </Border.Effect>
                        <ItemsControl ItemsSource="{Binding DataContext.QuickReactions, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource EmojiButton}" Width="34" Height="34"
                                            Command="{Binding DataContext.ReactCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <c:EmojiIcon Emoji="{Binding}" Size="19" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Grid>
            </StackPanel>

            <DataTemplate.Triggers>
                <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                    <Setter TargetName="ReactBar" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger SourceName="Bubble" Property="IsMouseOver" Value="True">
                    <Setter TargetName="ReactBar" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger SourceName="ReactBar" Property="IsMouseOver" Value="True">
                    <Setter TargetName="ReactBar" Property="Visibility" Value="Visible" />
                </Trigger>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" />
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="10" To="0" Duration="0:0:0.22">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColRail" Width="76" />
            <ColumnDefinition x:Name="ColList" Width="400" />
            <ColumnDefinition x:Name="ColChat" Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================ rail de navigation (verre) ============================ -->
        <Border Grid.Column="0" Width="64" HorizontalAlignment="Left" Margin="0,0,12,0" Style="{StaticResource GlassCard}" CornerRadius="32"
                Visibility="{Binding ShowList, Converter={StaticResource BoolVis}}">
            <Grid Margin="0,16,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="21" Background="{DynamicResource AccentGradient}" Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect Color="#2EE6A6" BlurRadius="18" ShadowDepth="0" Opacity="0.5" />
                        </Border.Effect>
                        <Path Data="{StaticResource IconChat}" Fill="#FFFFFF" Width="20" Height="20" Stretch="Uniform" />
                    </Border>
                    <Grid>
                        <RadioButton Style="{StaticResource RailButton}" GroupName="Rail" IsChecked="True"
                                     Command="{Binding CloseProfileCommand}" ToolTip="Discussions">
                            <Path Data="{StaticResource IconChat}" Style="{StaticResource Icon}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </RadioButton>
                        <Border Background="{DynamicResource AccentGradient}" CornerRadius="10" MinWidth="19" Height="19" Padding="5,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,-2,0" IsHitTestVisible="False"
                                Visibility="{Binding HasUnreadTotal, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding UnreadTotal}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <RadioButton Style="{StaticResource RailButton}" GroupName="Rail" Command="{Binding NewGroupCommand}" ToolTip="Nouveau groupe">
                        <Path Data="{StaticResource IconCommunities}" Style="{StaticResource Icon}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource RailButton}" GroupName="Rail" IsEnabled="False" ToolTip="Appels : boutons dans la discussion">
                        <Path Data="{StaticResource IconPhone}" Style="{StaticResource Icon}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    </RadioButton>
                </StackPanel>

                <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Command="{Binding ToggleThemeCommand}" ToolTip="Changer de thème (clair / sombre)">
                        <Path Data="{DynamicResource ThemeIcon}" Style="{StaticResource Icon}" />
                    </Button>
                    <Button Style="{StaticResource BareButton}" Command="{Binding OpenProfileCommand}" ToolTip="Mon profil" Margin="0,12,0,0">
                        <c:AvatarControl Size="42" Label="{Binding MeName}" Photo="{Binding MePhoto}" ShowOnline="True" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ liste des contacts (verre) ============================ -->
        <Border Grid.Column="1" Margin="0,0,12,0" Style="{StaticResource GlassCard}"
                Visibility="{Binding ShowList, Converter={StaticResource BoolVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Height="64" Margin="22,6,16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Command="{Binding CloseNewChatCommand}" Margin="-8,0,8,0"
                                Visibility="{Binding UsersMode, Converter={StaticResource BoolVis}}">
                            <Path Data="{StaticResource IconBack}" Style="{StaticResource Icon}" />
                        </Button>
                        <TextBlock Text="{Binding ListTitle}" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="NewBtn" Style="{StaticResource AccentCircleButton}" Click="New_Click" ToolTip="Nouvelle discussion ou nouveau groupe"
                            Width="42" Height="42" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconPlus}" Style="{StaticResource Icon}" Fill="#FFFFFF" Width="20" Height="20" />
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Nouvelle discussion" Command="{Binding NewChatCommand}" />
                                <MenuItem Header="Nouveau groupe" Command="{Binding NewGroupCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>

                <!-- état du réseau pair-à-pair + statuts -->
                <StackPanel Grid.Row="1" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" Margin="24,0,0,10" ToolTip="{Binding MyAddresses}">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Online}" VerticalAlignment="Center" Margin="0,1,8,0" />
                        <TextBlock Text="{Binding NetworkText}" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>

                    <!-- bande des statuts (stories) -->
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" Margin="16,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource BareButton}" Command="{Binding OpenMyStatusCommand}" ToolTip="Publier un statut">
                                <StackPanel Width="64" Margin="4,0,4,0">
                                    <Grid Width="52" Height="52" HorizontalAlignment="Center">
                                        <Ellipse Stroke="{DynamicResource Border}" StrokeThickness="2" StrokeDashArray="3 3" />
                                        <c:AvatarControl Size="40" Label="{Binding MeName}" Photo="{Binding MePhoto}" />
                                        <Border Width="19" Height="19" CornerRadius="10" Background="{DynamicResource AccentGradient}"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                BorderThickness="2" BorderBrush="{DynamicResource BgElevated}">
                                            <Path Data="{StaticResource IconPlus}" Fill="#FFFFFF" Width="11" Height="11" Stretch="Uniform" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="Mon statut" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>

                            <ItemsControl ItemsSource="{Binding OtherStatusGroups}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:StatusGroup}">
                                        <Button Style="{StaticResource BareButton}" Command="{Binding OpenCommand}" ToolTip="{Binding Subtitle}">
                                            <StackPanel Width="64" Margin="0,0,4,0">
                                                <Grid Width="52" Height="52" HorizontalAlignment="Center">
                                                    <Ellipse Stroke="{DynamicResource Border}" StrokeThickness="2" />
                                                    <Ellipse Stroke="{DynamicResource Accent}" StrokeThickness="2.5"
                                                             Visibility="{Binding HasUnseen, Converter={StaticResource BoolVis}}" />
                                                    <c:AvatarControl Size="40" Label="{Binding Name}" Photo="{Binding Photo}" />
                                                </Grid>
                                                <TextBlock Text="{Binding Name}" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0"
                                                           MaxWidth="64" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextSecondary}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>

                <Border Grid.Row="2" Height="46" Margin="16,0,16,12" Style="{StaticResource GlassPill}" CornerRadius="23">
                    <Grid>
                        <Path Data="{StaticResource IconSearch}" Style="{StaticResource Icon18}" HorizontalAlignment="Left" Margin="17,0,0,0" />
                        <TextBox Style="{StaticResource FlatBox}" Tag="Rechercher un contact" Margin="48,0,40,0"
                                 VerticalAlignment="Center" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Style="{StaticResource SmallIconButton}" Command="{Binding ClearSearchCommand}" HorizontalAlignment="Right" Margin="0,0,7,0"
                                Visibility="{Binding HasSearch, Converter={StaticResource BoolVis}}">
                            <Path Data="{StaticResource IconClose}" Style="{StaticResource Icon16}" />
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="18,0,16,10">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding UsersMode, Converter={StaticResource InvVis}}">
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="Filter" Content="Toutes"
                                     IsChecked="{Binding FilterAll, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="Filter" IsChecked="{Binding FilterUnread, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Non lues" />
                                <TextBlock Text="{Binding UnreadTotal}" FontSize="12" Margin="6,1,0,0"
                                           Visibility="{Binding HasUnreadTotal, Converter={StaticResource BoolVis}}" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- connexion manuelle (si la découverte automatique est bloquée) -->
                    <Border Style="{StaticResource GlassPill}" CornerRadius="20" Height="40" Visibility="{Binding UsersMode, Converter={StaticResource BoolVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource FlatBox}" Tag="Adresse manuelle  ex. 192.168.1.12:5050" Margin="16,0,6,0" FontSize="13.5"
                                     VerticalAlignment="Center" Text="{Binding ConnectAddress, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Style="{StaticResource TextButton}" Content="Connecter" Padding="0" Margin="0,0,6,0"
                                    Command="{Binding ConnectManualCommand}" IsEnabled="{Binding ConnectBusy, Converter={StaticResource InvBool}}" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="4">
                    <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Conversations}" Margin="0,0,0,10" />
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="30,40,30,0"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}">
                        <Path Data="{StaticResource IconDevices}" Style="{StaticResource Icon}" Width="46" Height="46" Opacity="0.35" />
                        <TextBlock Text="{Binding EmptyText}" TextAlignment="Center" Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,14,0,0" LineHeight="22" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <!-- ====== tiroir du profil (recouvre la liste) ====== -->
                <Border Grid.RowSpan="5" Background="{DynamicResource BgDrawer}" CornerRadius="28">
                    <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowProfile}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" />
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-40" To="0" Duration="0:0:0.28">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Height="70" Margin="14,4,0,0">
                            <Button Style="{StaticResource IconButton}" Command="{Binding CloseProfileCommand}" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconBack}" Style="{StaticResource Icon}" />
                            </Button>
                            <TextBlock Text="Profil" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="26,6,26,26">
                                <Grid Width="148" Height="148" HorizontalAlignment="Center" Margin="0,4,0,14">
                                    <c:AvatarControl Size="148" Label="{Binding MeName}" Photo="{Binding MePhoto}" />
                                    <Button Click="ChangePhoto_Click" Width="42" Height="42" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            ToolTip="Changer la photo" Style="{StaticResource AccentCircleButton}">
                                        <Path Data="{StaticResource IconCamera}" Style="{StaticResource Icon}" Fill="#FFFFFF" Width="20" Height="20" />
                                    </Button>
                                </Grid>
                                <TextBlock Text="{Binding MeName}" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding MeUsername, StringFormat='@{0}'}" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,22" />

                                <TextBlock Text="Nom affiché" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <TextBox Style="{StaticResource FlatBox}" MaxLength="40" Tag="Votre nom"
                                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />
                                </Border>
                                <TextBlock Text="Info" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <TextBox Style="{StaticResource FlatBox}" MaxLength="139" Tag="Une courte présentation"
                                             Text="{Binding EditAbout, UpdateSourceTrigger=PropertyChanged}" />
                                </Border>

                                <TextBlock Text="{Binding ProfileMessage}" TextWrapping="Wrap" FontSize="13" Margin="4,0,0,12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ProfileMessageIsError}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Button Style="{StaticResource PrimaryButton}" Content="Enregistrer" Command="{Binding SaveProfileCommand}"
                                        IsEnabled="{Binding ProfileBusy, Converter={StaticResource InvBool}}" />
                                <Button Style="{StaticResource TextButton}" Content="Supprimer la photo" Command="{Binding RemovePhotoCommand}" Margin="0,10,0,0" />

                                <Border Height="1" Background="{DynamicResource Divider}" Margin="0,14,0,14" />

                                <TextBlock Text="RÉSEAU PAIR-À-PAIR" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Mon adresse" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="{Binding MyAddresses}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,2,0,8" />
                                <TextBlock Text="{Binding DiscoveryText}" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="Si un PC n'apparaît pas : autorisez ChatLan dans le pare-feu Windows (réseau privé) et vérifiez que les deux PC sont sur le même réseau."
                                           TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextMuted}" Margin="0,6,0,0" />

                                <Border Height="1" Background="{DynamicResource Divider}" Margin="0,14,0,10" />

                                <Button Style="{StaticResource TextButton}" Command="{Binding ToggleThemeCommand}" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{DynamicResource ThemeIcon}" Style="{StaticResource Icon18}" Fill="{DynamicResource AccentText}" />
                                        <TextBlock Text="Changer de thème (clair / sombre)" Margin="10,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource DangerTextButton}" Command="{Binding LogoutCommand}" Margin="0,4,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconLogout}" Style="{StaticResource Icon18}" Fill="{DynamicResource Danger}" />
                                        <TextBlock Text="Se déconnecter" Margin="10,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ============================== conversation (verre) ============================== -->
        <Border Grid.Column="2" Style="{StaticResource GlassCard}" Visibility="{Binding ShowChat, Converter={StaticResource BoolVis}}">
            <Grid>
                <!-- écran d'attente -->
                <Grid Visibility="{Binding HasSelection, Converter={StaticResource InvVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                        <Border Width="116" Height="116" CornerRadius="58" Background="{DynamicResource AccentGradient}" HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#2EE6A6" BlurRadius="50" ShadowDepth="0" Opacity="0.5" />
                            </Border.Effect>
                            <Path Data="{StaticResource IconChat}" Fill="#FFFFFF" Width="54" Height="54" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="ChatLan" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,28,0,8"
                                   Foreground="{DynamicResource AccentGradient}" />
                        <TextBlock Text="Choisissez une discussion ou démarrez-en une nouvelle avec le bouton +."
                                   TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="15" LineHeight="23" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                            <Path Data="{StaticResource IconLock}" Style="{StaticResource Icon16}" Fill="{DynamicResource TextMuted}" />
                            <TextBlock Text="Pair-à-pair — vos messages ne passent par aucun serveur" FontSize="12.5" Margin="8,0,0,0" Foreground="{DynamicResource TextMuted}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- conversation ouverte -->
                <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- en-tête -->
                    <Border Grid.Row="0" Height="74" Background="{DynamicResource GlassFill}" CornerRadius="28,28,0,0"
                            BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
                        <Grid Margin="12,0,14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource IconButton}" Command="{Binding BackCommand}"
                                    Visibility="{Binding IsNarrow, Converter={StaticResource BoolVis}}">
                                <Path Data="{StaticResource IconBack}" Style="{StaticResource Icon}" />
                            </Button>
                            <c:AvatarControl Grid.Column="1" Size="48" Label="{Binding Selected.Name}" Photo="{Binding Selected.Photo}"
                                             ShowOnline="{Binding Selected.ShowOnlineDot}" Margin="8,0,14,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Selected.Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Selected.StatusText}" FontSize="13" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Selected.Online}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Selected.Typing}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <Button Grid.Column="3" Style="{StaticResource IconButton}" Command="{Binding StartAudioCallCommand}" ToolTip="Appel audio">
                                <Path Data="{StaticResource IconPhone}" Style="{StaticResource Icon}" />
                            </Button>
                            <Button Grid.Column="4" Style="{StaticResource IconButton}" Command="{Binding StartVideoCallCommand}" ToolTip="Appel vidéo">
                                <Path Data="{StaticResource IconVideo}" Style="{StaticResource Icon}" />
                            </Button>
                            <Button x:Name="MoreBtn" Grid.Column="5" Style="{StaticResource IconButton}" Click="More_Click" ToolTip="Plus d'options">
                                <Path Data="{StaticResource IconMore}" Style="{StaticResource Icon}" />
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Infos du groupe" Command="{Binding OpenGroupInfoCommand}"
                                                  Visibility="{Binding IsGroupChat, Converter={StaticResource BoolVis}}" />
                                        <MenuItem Header="Fermer la discussion" Command="{Binding CloseChatCommand}" />
                                        <MenuItem Header="Supprimer la discussion" Foreground="{DynamicResource Danger}" Command="{Binding DeleteCurrentChatCommand}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- messages -->
                    <Grid Grid.Row="1">
                        <Rectangle Fill="{DynamicResource Wallpaper}" Opacity="0.55" IsHitTestVisible="False" />
                        <ListBox x:Name="MsgList" Style="{StaticResource PlainList}" ItemsSource="{Binding Messages}" Padding="26,10,26,16"
                                 VirtualizingStackPanel.IsVirtualizing="False" AllowDrop="True" Drop="Chat_Drop" DragOver="Chat_DragOver" />

                        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" CornerRadius="22"
                                Background="{DynamicResource BgElevated}" Visibility="{Binding HasMore, Converter={StaticResource BoolVis}}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.3" />
                            </Border.Effect>
                            <Button Style="{StaticResource TextButton}" Content="Afficher les messages précédents" Command="{Binding LoadOlderCommand}"
                                    IsEnabled="{Binding LoadingOlder, Converter={StaticResource InvBool}}" FontSize="13" />
                        </Border>

                        <!-- indicateur de saisie -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="26,0,0,14"
                                Padding="15,12" CornerRadius="18,18,18,6" Background="{DynamicResource BubbleIn}"
                                BorderBrush="{DynamicResource BubbleInBorder}" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Selected.Typing}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="Dot1" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.45" AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetName="Dot2" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.45" AutoReverse="True" BeginTime="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="Dot3" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.45" AutoReverse="True" BeginTime="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="Dot1" Width="7" Height="7" Fill="{DynamicResource TextSecondary}" Margin="0,0,4,0" />
                                <Ellipse x:Name="Dot2" Width="7" Height="7" Fill="{DynamicResource TextSecondary}" Margin="0,0,4,0" />
                                <Ellipse x:Name="Dot3" Width="7" Height="7" Fill="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- zone de saisie -->
                    <Border Grid.Row="2" Background="{DynamicResource GlassFill}" CornerRadius="0,0,28,28"
                            BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="18,10,18,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- bandeau de réponse -->
                            <Border Grid.Row="0" Background="{DynamicResource QuoteBg}" CornerRadius="14" Padding="0,8,8,8" Margin="0,0,0,8"
                                    Visibility="{Binding HasReply, Converter={StaticResource BoolVis}}">
                                <Grid>
                                    <Border Width="3" CornerRadius="2" Background="{DynamicResource Accent}" HorizontalAlignment="Left" />
                                    <StackPanel Margin="12,0,34,0">
                                        <TextBlock Text="{Binding ReplyAuthor}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" />
                                        <TextBlock Text="{Binding ReplyPreview}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextSecondary}" MaxHeight="34" />
                                    </StackPanel>
                                    <Button Style="{StaticResource SmallIconButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Command="{Binding CancelReplyCommand}" ToolTip="Annuler">
                                        <Path Data="{StaticResource IconClose}" Style="{StaticResource Icon16}" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- bandeau de modification -->
                            <Border Grid.Row="0" Background="{DynamicResource AccentSoft}" CornerRadius="14" Padding="0,8,8,8" Margin="0,0,0,8"
                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolVis}}">
                                <Grid>
                                    <Border Width="3" CornerRadius="2" Background="{DynamicResource Accent}" HorizontalAlignment="Left" />
                                    <StackPanel Margin="12,0,34,0">
                                        <TextBlock Text="Modifier le message" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" />
                                        <TextBlock Text="{Binding EditingPreview}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextSecondary}" MaxHeight="34" />
                                    </StackPanel>
                                    <Button Style="{StaticResource SmallIconButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Command="{Binding CancelEditCommand}" ToolTip="Annuler">
                                        <Path Data="{StaticResource IconClose}" Style="{StaticResource Icon16}" />
                                    </Button>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource GlassPill}" CornerRadius="26" MinHeight="50">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="AttachBtn" Style="{StaticResource IconButton}" Click="Attach_Click" VerticalAlignment="Bottom"
                                                Margin="5,0,0,4" ToolTip="Joindre un fichier">
                                            <Path Data="{StaticResource IconAttach}" Style="{StaticResource Icon}" />
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Photo ou GIF" Command="{Binding AttachImageCommand}" />
                                                    <MenuItem Header="Vidéo" Command="{Binding AttachVideoCommand}" />
                                                    <MenuItem Header="Document (PDF, Word…)" Command="{Binding AttachDocumentCommand}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                        <Button x:Name="EmojiBtn" Grid.Column="1" Style="{StaticResource IconButton}" Click="Emoji_Click"
                                                VerticalAlignment="Bottom" Margin="0,0,0,4" ToolTip="Emojis et stickers">
                                            <Path Data="{StaticResource IconEmoji}" Style="{StaticResource Icon}" />
                                        </Button>
                                        <TextBox x:Name="Input" Grid.Column="2" Style="{StaticResource FlatBox}" Tag="Écrivez un message" FontSize="15"
                                                 Padding="8,13,14,13" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="140"
                                                 VerticalScrollBarVisibility="Auto" VerticalAlignment="Center"
                                                 Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="Input_PreviewKeyDown" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
                                    <Button Style="{StaticResource IconButton}" Width="50" Height="50" Command="{Binding StartVoiceCommand}"
                                            ToolTip="Message vocal" Background="{DynamicResource GlassInput}">
                                        <Path Data="{StaticResource IconMic}" Style="{StaticResource Icon}" Fill="{DynamicResource AccentText}" />
                                    </Button>
                                    <Button Style="{StaticResource AccentCircleButton}" Width="50" Height="50" Command="{Binding SendCommand}"
                                            Margin="8,0,0,0" ToolTip="Envoyer (Entrée)">
                                        <Path Data="{StaticResource IconSend}" Style="{StaticResource Icon}" Fill="#FFFFFF" Width="22" Height="22" />
                                    </Button>
                                </StackPanel>

                                <!-- enregistrement en cours -->
                                <Border Grid.ColumnSpan="2" Background="{DynamicResource BgElevated}" BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1" CornerRadius="26" Padding="16,0" Height="50"
                                        Visibility="{Binding IsRecording, Converter={StaticResource BoolVis}}">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="11" Height="11" Fill="{DynamicResource RecordRed}" VerticalAlignment="Center">
                                                <Ellipse.Triggers>
                                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.7" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Ellipse.Triggers>
                                            </Ellipse>
                                            <TextBlock Text="Enregistrement" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding RecordTime}" FontFamily="Consolas" Margin="10,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondary}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Style="{StaticResource TextButton}" Content="Annuler" Command="{Binding CancelVoiceCommand}"
                                                    Foreground="{DynamicResource Danger}" />
                                            <Button Style="{StaticResource AccentCircleButton}" Width="38" Height="38" Margin="6,0,0,0"
                                                    Command="{Binding StopVoiceSendCommand}" ToolTip="Envoyer le message vocal">
                                                <Path Data="{StaticResource IconSend}" Style="{StaticResource Icon}" Fill="#FFFFFF" Width="18" Height="18" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Popup x:Name="EmojiPopup" PlacementTarget="{Binding ElementName=EmojiBtn}" Placement="Top" StaysOpen="False"
                                       AllowsTransparency="True" VerticalOffset="-6">
                                    <Border Margin="12" Padding="10" Width="376" MaxHeight="440" Background="{DynamicResource BgElevated}"
                                            BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="18"
                                            TextElement.Foreground="{DynamicResource TextPrimary}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.4" />
                                        </Border.Effect>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="2">
                                                <TextBlock Text="EMOJIS" Style="{StaticResource SectionTitle}" />
                                                <ItemsControl ItemsSource="{Binding Emojis}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource EmojiButton}"
                                                                    Command="{Binding DataContext.AddEmojiCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}">
                                                                <c:EmojiIcon Emoji="{Binding}" Size="24" />
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <TextBlock Text="STICKERS ANIMÉS / GIFS" Style="{StaticResource SectionTitle}" Margin="4,10,0,8" />
                                                <ItemsControl ItemsSource="{Binding Stickers}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource EmojiButton}" Width="58" Height="58"
                                                                    Command="{Binding DataContext.SendStickerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}">
                                                                <c:StickerControl Emoji="{Binding}" EmojiSize="34" />
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- ============================ fenêtres superposées ============================ -->
        <views:GroupCreateView Grid.ColumnSpan="3" />
        <views:StatusComposerView Grid.ColumnSpan="3" />
        <views:StatusViewerView Grid.ColumnSpan="3" />
        <views:GroupInfoView Grid.ColumnSpan="3" />
        <views:ForwardView Grid.ColumnSpan="3" />
        <views:CallView Grid.ColumnSpan="3" />

        <!-- ============================ notification ============================ -->
        <Border Grid.ColumnSpan="3" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="14" Padding="14,12,16,12" MaxWidth="360"
                CornerRadius="20" Cursor="Hand" Background="{DynamicResource BgElevated}" BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1">
            <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.45" />
            </Border.Effect>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToastVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="60" To="0" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding OpenToastCommand}" />
            </Border.InputBindings>
            <StackPanel Orientation="Horizontal">
                <c:AvatarControl Size="42" Label="{Binding ToastTitle}" Photo="{Binding ToastPhoto}" VerticalAlignment="Center" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" MaxWidth="250">
                    <TextBlock Text="{Binding ToastTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ToastText}" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" FontSize="13" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
