<UserControl x:Class="ChatLan.Views.ForwardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ChatLan.Controls">
    <Grid Background="{DynamicResource Backdrop}" Visibility="{Binding ShowForward, Converter={StaticResource BoolVis}}">
        <Border Style="{StaticResource SheetCard}" Width="420" MaxHeight="580" Padding="24,20,24,18" VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,14">
                    <Path Data="{StaticResource IconForward}" Style="{StaticResource Icon}" Fill="{DynamicResource AccentText}" />
                    <TextBlock Text="Transférer vers…" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <Button Style="{StaticResource SmallIconButton}" HorizontalAlignment="Right" Margin="0,0,-6,0"
                            Command="{Binding CloseForwardCommand}" ToolTip="Annuler">
                        <Path Data="{StaticResource IconClose}" Style="{StaticResource Icon16}" />
                    </Button>
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource GlassPill}" CornerRadius="20" Height="42" Margin="0,0,0,12">
                    <Grid>
                        <Path Data="{StaticResource IconSearch}" Style="{StaticResource Icon16}" HorizontalAlignment="Left" Margin="15,0,0,0" />
                        <TextBox Style="{StaticResource FlatBox}" Tag="Rechercher une discussion" Margin="44,0,12,0" FontSize="13.5"
                                 VerticalAlignment="Center" Text="{Binding ForwardSearch, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ForwardTargets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ListRowButton}" Height="62"
                                        Command="{Binding DataContext.ForwardToCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid Margin="8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <c:AvatarControl Size="40" Label="{Binding Name}" Photo="{Binding Photo}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Path Grid.Column="2" Data="{StaticResource IconChevronRight}" Style="{StaticResource Icon18}"
                                              Fill="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
