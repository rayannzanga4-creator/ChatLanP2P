<UserControl x:Class="ChatLan.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="FeatureCard" TargetType="Border" BasedOn="{StaticResource GlassCard}">
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Margin" Value="7" />
        </Style>
        <Style x:Key="FeatureIconBox" TargetType="Border">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{DynamicResource AccentGradient}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HeroPanel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6" />
                    <DoubleAnimation Storyboard.TargetName="HeroPanel" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="30" To="0" Duration="0:0:0.65">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="FeatureGrid" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6" BeginTime="0:0:0.2" />
                    <DoubleAnimation Storyboard.TargetName="FeatureGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="30" To="0" Duration="0:0:0.65" BeginTime="0:0:0.2">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="ActionPanel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6" BeginTime="0:0:0.4" />
                    <DoubleAnimation Storyboard.TargetName="ActionPanel" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="30" To="0" Duration="0:0:0.65" BeginTime="0:0:0.4">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <Button Style="{StaticResource IconButton}" Command="{Binding ToggleThemeCommand}" ToolTip="Changer de thème"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20">
            <Path Data="{DynamicResource ThemeIcon}" Style="{StaticResource Icon}" />
        </Button>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MinHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="600" Margin="24,50">

                    <StackPanel x:Name="HeroPanel" Opacity="0" HorizontalAlignment="Center">
                        <StackPanel.RenderTransform><TranslateTransform Y="30" /></StackPanel.RenderTransform>
                        <Border Width="112" Height="112" CornerRadius="56" Background="{DynamicResource AccentGradient}" HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#2EE6A6" BlurRadius="50" ShadowDepth="0" Opacity="0.55" />
                            </Border.Effect>
                            <Path Data="{StaticResource IconChat}" Fill="#FFFFFF" Width="52" Height="52" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="ChatLan" FontSize="52" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,26,0,6"
                                   Foreground="{DynamicResource AccentGradient}" />
                        <TextBlock Text="La messagerie pair-à-pair de votre réseau local,&#10;sans serveur et sans internet."
                                   FontSize="17" TextAlignment="Center" LineHeight="26"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,34" />
                    </StackPanel>

                    <UniformGrid x:Name="FeatureGrid" Columns="2" Opacity="0" Margin="0,0,0,34">
                        <UniformGrid.RenderTransform><TranslateTransform Y="30" /></UniformGrid.RenderTransform>
                        <Border Style="{StaticResource FeatureCard}">
                            <StackPanel>
                                <Border Style="{StaticResource FeatureIconBox}"><Path Data="{StaticResource IconDevices}" Style="{StaticResource Icon}" Fill="#FFFFFF" /></Border>
                                <TextBlock Text="Pair-à-pair" FontWeight="SemiBold" FontSize="15.5" />
                                <TextBlock Text="Aucun serveur : vos PC se parlent directement." TextWrapping="Wrap" Margin="0,4,0,0" FontSize="13" Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource FeatureCard}">
                            <StackPanel>
                                <Border Style="{StaticResource FeatureIconBox}"><Path Data="{StaticResource IconLock}" Style="{StaticResource Icon}" Fill="#FFFFFF" /></Border>
                                <TextBlock Text="100 % local" FontWeight="SemiBold" FontSize="15.5" />
                                <TextBlock Text="Fonctionne sur votre réseau, sans connexion internet." TextWrapping="Wrap" Margin="0,4,0,0" FontSize="13" Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource FeatureCard}">
                            <StackPanel>
                                <Border Style="{StaticResource FeatureIconBox}"><Path Data="{StaticResource IconSend}" Style="{StaticResource Icon}" Fill="#FFFFFF" /></Border>
                                <TextBlock Text="Temps réel" FontWeight="SemiBold" FontSize="15.5" />
                                <TextBlock Text="Messages instantanés, coches envoyé / reçu / lu." TextWrapping="Wrap" Margin="0,4,0,0" FontSize="13" Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource FeatureCard}">
                            <StackPanel>
                                <Border Style="{StaticResource FeatureIconBox}"><Path Data="{StaticResource IconCheckDouble}" Style="{StaticResource Icon}" Fill="#FFFFFF" /></Border>
                                <TextBlock Text="Jamais perdus" FontWeight="SemiBold" FontSize="15.5" />
                                <TextBlock Text="Un contact est absent ? Le message part dès son retour." TextWrapping="Wrap" Margin="0,4,0,0" FontSize="13" Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <StackPanel x:Name="ActionPanel" Opacity="0" HorizontalAlignment="Center">
                        <StackPanel.RenderTransform><TranslateTransform Y="30" /></StackPanel.RenderTransform>
                        <Button Style="{StaticResource PrimaryButton}" Content="Se connecter" Command="{Binding LoginCommand}" Width="290" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Créer un compte" Command="{Binding RegisterCommand}" Width="290" Margin="0,12,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
