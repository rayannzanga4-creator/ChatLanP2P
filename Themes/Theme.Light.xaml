<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Thème clair : fonds doux bleu-vert, cartes blanches nettes, texte bien contrasté.
         Les accents restent l'émeraude du thème sombre pour une identité cohérente. -->
    <LinearGradientBrush x:Key="AppBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F2F6FD" Offset="0" />
        <GradientStop Color="#F7F3FD" Offset="0.55" />
        <GradientStop Color="#EDF9F5" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="BlobA" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#3D7C6CFF" Offset="0" />
        <GradientStop Color="#007C6CFF" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="BlobB" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#382ED3A5" Offset="0" />
        <GradientStop Color="#002ED3A5" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="BlobC" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#2EFF9AB8" Offset="0" />
        <GradientStop Color="#00FF9AB8" Offset="1" />
    </RadialGradientBrush>

    <SolidColorBrush x:Key="TitleBarColor" Color="#F2F6FD" />
    <SolidColorBrush x:Key="TitleBarText" Color="#18203A" />

    <SolidColorBrush x:Key="GlassFill" Color="#D9FFFFFF" />
    <SolidColorBrush x:Key="GlassFillStrong" Color="#F5FFFFFF" />
    <SolidColorBrush x:Key="GlassHover" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="GlassActive" Color="#FFFFFF" />
    <SolidColorBrush x:Key="GlassInput" Color="#F7FFFFFF" />
    <LinearGradientBrush x:Key="GlassBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#59C7D2E8" Offset="0.5" />
        <GradientStop Color="#D9FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="BgApp" Color="#F2F6FD" />
    <SolidColorBrush x:Key="BgPanel" Color="#00000000" />
    <SolidColorBrush x:Key="BgElevated" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BgDrawer" Color="#FAFFFFFF" />
    <SolidColorBrush x:Key="BgHover" Color="#EAF0FA" />
    <SolidColorBrush x:Key="BgActive" Color="#DEE7F6" />
    <SolidColorBrush x:Key="BgInput" Color="#F2F6FD" />
    <SolidColorBrush x:Key="BgSearch" Color="#F2F6FD" />
    <SolidColorBrush x:Key="PillBg" Color="#F1F5FC" />
    <SolidColorBrush x:Key="Border" Color="#241B2544" />
    <SolidColorBrush x:Key="Divider" Color="#141B2544" />
    <SolidColorBrush x:Key="BorderStrong" Color="#331B2544" />

    <SolidColorBrush x:Key="TextPrimary" Color="#18203A" />
    <SolidColorBrush x:Key="TextSecondary" Color="#4E5A78" />
    <SolidColorBrush x:Key="TextMuted" Color="#77839F" />

    <SolidColorBrush x:Key="Accent" Color="#10A67B" />
    <SolidColorBrush x:Key="AccentHover" Color="#0C8F69" />
    <SolidColorBrush x:Key="AccentText" Color="#0A8A66" />
    <SolidColorBrush x:Key="AccentSoft" Color="#1F10A67B" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#25C79B" Offset="0" />
        <GradientStop Color="#0E9A76" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="BubbleIn" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BubbleInBorder" Color="#E4EAF6" />
    <LinearGradientBrush x:Key="BubbleOut" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#23C099" Offset="0" />
        <GradientStop Color="#0C8F70" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BubbleOutText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BubbleMetaIn" Color="#6E7A96" />
    <SolidColorBrush x:Key="BubbleMetaOut" Color="#DBFFFFFF" />
    <SolidColorBrush x:Key="TickNormal" Color="#E0FFFFFF" />
    <SolidColorBrush x:Key="TickRead" Color="#BFF1FF" />

    <SolidColorBrush x:Key="Danger" Color="#D93A50" />
    <SolidColorBrush x:Key="Online" Color="#12B981" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#26000000" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#4D000000" />
    <SolidColorBrush x:Key="Backdrop" Color="#66101838" />

    <!-- Niveau 2 : pièces jointes, réponses, réactions, appels -->
    <SolidColorBrush x:Key="MediaBg" Color="#EFF3FB" />
    <SolidColorBrush x:Key="QuoteBg" Color="#F0F4FD" />
    <SolidColorBrush x:Key="ReactionBg" Color="#EEF3FC" />
    <SolidColorBrush x:Key="ReactionMineBg" Color="#DFF4EC" />
    <SolidColorBrush x:Key="CallBackground" Color="#0E1226" />
    <SolidColorBrush x:Key="CallTile" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="RecordRed" Color="#E23A52" />
    <SolidColorBrush x:Key="SheetBg" Color="#FFFFFF" />

    <Geometry x:Key="ThemeIcon">M10,2c-1.61,0 -3.14,0.4 -4.47,1.1C8.36,4.4 10,7 10,10s-1.64,5.6 -4.47,6.9C6.86,17.6 8.39,18 10,18c4.42,0 8,-3.58 8,-8s-3.58,-8 -8,-8z</Geometry>
</ResourceDictionary>
