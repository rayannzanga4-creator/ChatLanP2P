<UserControl x:Class="ChatLan.Views.AuthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4" />
                    <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="24" To="0" Duration="0:0:0.45">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>

        <Button Style="{StaticResource IconButton}" Command="{Binding GoBackCommand}" ToolTip="Retour à l'accueil"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18">
            <Path Data="{StaticResource IconBack}" Style="{StaticResource Icon}" />
        </Button>
        <Button Style="{StaticResource IconButton}" Command="{Binding ToggleThemeCommand}" ToolTip="Changer de thème"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="18">
            <Path Data="{DynamicResource ThemeIcon}" Style="{StaticResource Icon}" />
        </Button>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MinHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                <Border x:Name="Card" Width="440" Margin="16,64,16,40" Padding="34,30,34,28" VerticalAlignment="Center"
                        Background="{DynamicResource GlassFillStrong}" BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1"
                        CornerRadius="30" Opacity="0">
                    <Border.RenderTransform><TranslateTransform Y="24" /></Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="50" ShadowDepth="12" Opacity="0.35" />
                    </Border.Effect>
                    <StackPanel>
                        <Border Width="62" Height="62" CornerRadius="31" Background="{DynamicResource AccentGradient}" HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#21C063" BlurRadius="24" ShadowDepth="0" Opacity="0.45" />
                            </Border.Effect>
                            <Path Data="{StaticResource IconChat}" Fill="#FFFFFF" Width="30" Height="30" Stretch="Uniform" />
                        </Border>

                        <TextBlock FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,16,0,2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Bon retour" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRegister}" Value="True">
                                            <Setter Property="Text" Value="Créer votre compte" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock FontSize="13.5" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,20">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Ouvrez votre session pour rejoindre le réseau." />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRegister}" Value="True">
                                            <Setter Property="Text" Value="Créez votre profil : il vous identifie sur le réseau local." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- onglets -->
                        <Border Background="{DynamicResource BgSearch}" CornerRadius="13" Padding="4" Margin="0,0,0,22">
                            <UniformGrid Columns="2">
                                <RadioButton Style="{StaticResource SegmentTab}" GroupName="AuthTabs" Content="Connexion"
                                             IsChecked="{Binding IsRegister, Converter={StaticResource InvBool}, Mode=TwoWay}" />
                                <RadioButton Style="{StaticResource SegmentTab}" GroupName="AuthTabs" Content="Inscription"
                                             IsChecked="{Binding IsRegister, Mode=TwoWay}" />
                            </UniformGrid>
                        </Border>

                        <TextBlock Text="Nom d'utilisateur" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Path Data="{StaticResource IconPerson}" Style="{StaticResource Icon18}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBox x:Name="UsernameBox" Grid.Column="1" Style="{StaticResource FlatBox}" Tag="ex. marie_k"
                                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>

                        <StackPanel Visibility="{Binding IsRegister, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="Nom affiché" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconPencil}" Style="{StaticResource Icon18}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Style="{StaticResource FlatBox}" Tag="ex. Marie Kamga" MaxLength="40"
                                             Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Mot de passe" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Path Data="{StaticResource IconLock}" Style="{StaticResource Icon18}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <PasswordBox x:Name="PasswordBox" Grid.Column="1" Style="{StaticResource FlatPassword}" />
                            </Grid>
                        </Border>

                        <StackPanel Visibility="{Binding IsRegister, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="Confirmer le mot de passe" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconLock}" Style="{StaticResource Icon18}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <PasswordBox x:Name="ConfirmBox" Grid.Column="1" Style="{StaticResource FlatPassword}" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Border Background="Transparent" BorderBrush="{DynamicResource Danger}" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Error}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconInfo}" Style="{StaticResource Icon16}" Fill="{DynamicResource Danger}" VerticalAlignment="Top" Margin="0,2,10,0" />
                                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" MaxWidth="330" FontSize="13" />
                            </StackPanel>
                        </Border>

                        <Button Command="{Binding SubmitCommand}" IsDefault="True" Margin="0,4,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Setter Property="Content" Value="Se connecter" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRegister}" Value="True">
                                            <Setter Property="Content" Value="Créer mon compte" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Busy}" Value="True">
                                            <Setter Property="Content" Value="Connexion au réseau…" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <TextBlock Text="Votre compte reste sur cet ordinateur. Aucun serveur, aucune connexion internet." FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextMuted}" Margin="0,16,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
