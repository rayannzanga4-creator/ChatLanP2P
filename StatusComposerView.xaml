<UserControl x:Class="ChatLan.Views.StatusComposerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ChatLan.Controls"
             xmlns:vm="clr-namespace:ChatLan.ViewModels">
    <Grid Background="{DynamicResource Backdrop}" Visibility="{Binding ShowStatusComposer, Converter={StaticResource BoolVis}}">
        <Border Style="{StaticResource SheetCard}" Width="470" MaxHeight="720" Padding="26,22,26,20" VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- en-tête -->
                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,16">
                    <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource AccentGradient}">
                        <Path Data="{StaticResource IconStatus}" Fill="#FFFFFF" Width="20" Height="20" Stretch="Uniform" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Nouveau statut" FontSize="21" FontWeight="Bold" />
                        <TextBlock Text="Visible pendant 24 heures" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                </StackPanel>

                <!-- texte / légende -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="TEXTE OU LÉGENDE" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                    <Border Style="{StaticResource FieldBorder}">
                        <TextBox Style="{StaticResource FlatBox}" Text="{Binding StatusText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxLength="700" MaxHeight="150"
                                 VerticalScrollBarVisibility="Auto" Padding="14,10" />
                    </Border>
                </StackPanel>

                <!-- emojis à insérer -->
                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,10,0,0">
                    <ItemsControl ItemsSource="{Binding StatusEmojis}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource EmojiButton}"
                                        Command="{Binding DataContext.InsertStatusEmojiCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <c:EmojiIcon Emoji="{Binding}" Size="22" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- couleurs de fond -->
                <StackPanel Grid.Row="3" Margin="0,10,0,0">
                    <TextBlock Text="COULEUR DU FOND" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding StatusColorOptions}" Margin="0,4,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StatusColorOption}">
                                <Button Style="{StaticResource BareButton}" Width="38" Height="38" Margin="0,0,6,0"
                                        ToolTip="Choisir cette couleur"
                                        Command="{Binding DataContext.PickStatusColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Index}">
                                    <Grid Width="34" Height="34">
                                        <Ellipse Fill="{Binding Brush}" Width="28" Height="28" />
                                        <Ellipse Width="34" Height="34" Stroke="{DynamicResource TextPrimary}" StrokeThickness="2"
                                                 Visibility="{Binding IsSelected, Converter={StaticResource BoolVis}}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- pièce jointe -->
                <StackPanel Grid.Row="4" Margin="0,12,0,0">
                    <TextBlock Text="IMAGE OU VIDÉO" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Button Style="{StaticResource TextButton}" Content="Ajouter une image" Padding="0"
                                Command="{Binding AddStatusImageCommand}" />
                        <Button Style="{StaticResource TextButton}" Content="Ajouter une vidéo" Padding="0" Margin="18,0,0,0"
                                Command="{Binding AddStatusVideoCommand}" />
                    </StackPanel>
                    <Border Margin="0,10,0,0" Padding="10" CornerRadius="12" Background="{DynamicResource MediaBg}"
                            Visibility="{Binding StatusHasMedia, Converter={StaticResource BoolVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="58" Height="58" CornerRadius="9" ClipToBounds="True" Background="#22000000">
                                <Image Source="{Binding StatusPhoto}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusMediaLabel}" FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" MaxWidth="240" />
                                <TextBlock Text="Sera jointe au statut" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource TextButton}" Content="Retirer"
                                    Foreground="{DynamicResource Danger}" Command="{Binding ClearStatusMediaCommand}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- audience -->
                <StackPanel Grid.Row="5" Margin="0,14,0,0">
                    <TextBlock Text="QUI PEUT VOIR CE STATUT" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <RadioButton GroupName="StatusAudience" Content="Mes contacts" Margin="0,0,18,0"
                                     IsChecked="{Binding StatusAudienceContacts, Mode=TwoWay}" />
                        <RadioButton GroupName="StatusAudience" Content="Personnes choisies"
                                     IsChecked="{Binding StatusAudienceOnly, Mode=TwoWay}" />
                    </StackPanel>
                    <ScrollViewer MaxHeight="132" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"
                                  Visibility="{Binding StatusAudienceOnly, Converter={StaticResource BoolVis}}">
                        <ItemsControl ItemsSource="{Binding StatusAudiencePicks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ContactChoice}">
                                    <CheckBox Style="{StaticResource ChoiceCheck}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,1">
                                        <StackPanel Orientation="Horizontal">
                                            <c:AvatarControl Size="30" Label="{Binding Name}" Photo="{Binding Photo}" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- actions -->
                <Grid Grid.Row="6" Margin="0,18,0,0">
                    <Button Style="{StaticResource SecondaryButton}" Content="Annuler" HorizontalAlignment="Left" Padding="22,10"
                            Command="{Binding CloseStatusComposerCommand}" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Publier" HorizontalAlignment="Right" Padding="26,11"
                            Command="{Binding PublishStatusCommand}" IsEnabled="{Binding StatusPublishing, Converter={StaticResource InvBool}}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
